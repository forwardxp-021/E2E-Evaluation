  "field_rules": {
    "reference_target": "Reference and Target must be explicit IDs. Target-minus-Reference is the only semantic delta sign convention.",
    "bdd_direction": "BDD magnitude, Z_BDD, and p-values never determine aggressive/conservative or better/worse direction.",
    "semantic_binding": "A directional conclusion requires at least one dimension-approved semantic delta with its unit, finite sample count, and confidence interval.",
    "shared_bdd": "If one task-level BDD supports multiple semantic child dimensions, rows must share parent_bdd_result_id and must not be counted as independent BDD tests.",
    "raw_mmd2": "Raw MMD2 may be shown for audit within a representation but must never be used to rank different representations.",
    "multiplicity": "Raw and corrected p-values must both be retained. A corrected decision is mandatory when the result belongs to a frozen multiplicity family.",
    "unpaired": "Unpaired rows must report A/A calibration source, held-out FPR, log/scenario overlap rules, and both A/B directions when available.",
    "legacy": "Missing historical fields are N/A with a frozen reason. They must not be reconstructed silently or replaced with fields from another scope.",
    "proxy": "A proxy mapping must be labeled and cannot be promoted to an exact dimension claim."
  },
  "table_a_business_columns": [
    "Behavior dimension",
    "Reference to Target",
    "Task / slice",
    "Mode",
    "N scenario / N log",
    "Representation",
    "Z_BDD",
    "Significance",
    "Semantic delta",
    "Direction",
    "Conclusion"
  ],
  "table_b_scorecard_columns": [
    "Representation",
    "Longitudinal",
    "Following",
    "Lane change",
    "Interaction",
    "Unpaired release detection",
    "A/A FPR",
    "Detection minus FPR",
    "Seed stability",
    "Capability conclusion"
  ],
  "comparability_rules": [
    "Behavior Profile rows answer what changed and must not be replaced by representation gate summaries.",
    "Representation Scorecard rows answer evaluator reliability and must not be interpreted as semantic behavior direction.",
    "Cross-representation ranking may use detection rate, A/A FPR, detection-minus-FPR, minimum detectable dose, task coverage, within-representation normalized Z, and seed stability.",
    "Cross-representation raw MMD2 comparison is prohibited.",
    "Paired and unpaired results must never be pooled into one capability number."
  ]
}
