{
  "schema_version": "unified_bdd_reporting_schema_v1",
  "status": "UNIFIED_BDD_REPORTING_SCHEMA_FROZEN",
  "frozen_on": "2026-08-14",
  "scope": "all future BDD behavior profiles and representation evaluations",
  "concepts": {
    "behavior_drift_profile": "Which behavior dimensions changed in Target relative to Reference, with direction determined only by semantic deltas.",
    "bdd_statistic": "How strongly two behavior-representation distributions differ under a fixed task, Reference, Target, representation, and null.",
    "representation_evaluation": "How reliably a representation detects a known treatment using predeclared capability metrics."
  },
  "canonical_notation": "BDD(Target | Reference, task, representation, evaluation_mode)",
  "delta_convention": "Target minus Reference",
  "evaluation_mode_enum": [
    "paired",
    "unpaired"
  ],
  "mapping_strength_enum": [
    "EXACT_DIMENSION",
    "TASK_SLICE_PROXY",
    "TREATMENT_ALIGNED_PROXY",
    "MIXED_PROXY",
    "REPRESENTATION_EVALUATION_ONLY",
    "SEMANTIC_ONLY",
    "INSUFFICIENT_FOR_DIMENSION_CLAIM"
  ],
  "value_status_enum": [
    "AVAILABLE",
    "N/A_NO_ELIGIBLE_SAMPLES",
    "N/A_NOT_APPLICABLE_TO_SLICE",
    "EVIDENCE_GAP_BDD_NOT_COMPUTED",
    "EVIDENCE_GAP_SEMANTIC_DELTA_NOT_COMPUTED",
    "EVIDENCE_GAP_REPRESENTATION_NOT_EVALUATED",
    "LEGACY_FIELD_NOT_ARCHIVED",
    "PROXY_ONLY_NOT_CONFIRMATORY"
  ],
