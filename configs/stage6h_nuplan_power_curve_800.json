{
  "schema_version": "stage6f_nuplan_power_curve_design_v1",
  "row_id_column": "global_row",
  "pair_id_column": "scenario_token",
  "cluster_column": "log_name",
  "planner_column": "planner_name",
  "planners": {
    "assertive": "pdm_closed_assertive_v1",
    "conservative": "pdm_closed_conservative_v1"
  },
  "invariant_pair_columns": [
    "map_name",
    "scenario_type"
  ],
  "covariates": [
    {"name": "map_name", "kind": "categorical", "timing": "pre_treatment"},
    {"name": "scenario_type", "kind": "categorical", "timing": "pre_treatment"}
  ],
  "tasks": [
    {
      "name": "following_interaction",
      "column": "scenario_type",
      "positive_values": ["following_lane_with_lead", "following_lane_with_slow_lead", "near_long_vehicle"],
      "timing": "pre_treatment"
    },
    {
      "name": "lane_change",
      "column": "scenario_type",
      "positive_values": ["changing_lane_to_left", "changing_lane_to_right"],
      "timing": "pre_treatment"
    },
    {
      "name": "stop_go_control",
      "column": "scenario_type",
      "positive_values": ["accelerating_at_traffic_light_with_lead", "stationary_at_traffic_light_without_lead", "stationary_in_traffic", "stopping_at_traffic_light_with_lead", "stopping_with_lead"],
      "timing": "pre_treatment"
    },
    {
      "name": "high_motion_dynamics",
      "column": "scenario_type",
      "positive_values": ["high_lateral_acceleration", "high_magnitude_speed", "medium_magnitude_speed"],
      "timing": "pre_treatment"
    },
    {
      "name": "dense_or_vulnerable_interaction",
      "column": "scenario_type",
      "positive_values": ["near_multiple_vehicles", "near_pedestrian_on_crosswalk"],
      "timing": "pre_treatment"
    }
  ],
  "post_treatment_columns": ["pair_quality_tier", "fallback_rate", "actual_lane_change", "hard_brake"],
  "support_thresholds": {
    "min_support_fraction_per_group": 0.7,
    "min_ess_ratio_per_group": 0.4,
    "max_weight_ratio": 12.0,
    "min_clusters_per_group": 8
  },
  "sample_sizes_per_release": [200, 250, 300, 400],
  "log_split_strategy": "sequential_full_log_pool_v1",
  "seed": 20260810,
  "alpha": 0.05,
  "target_detection_rate": 0.8,
  "target_false_positive_rate": 0.05,
  "calibration_trials_per_planner": 100,
  "evaluation_trials_per_planner": 100,
  "ab_trials_per_direction": 100,
  "split_search_candidates": 24,
  "max_mmd_samples": 2000,
  "minimum_valid_trials": 50
}
